# Hindsight Cloud API key (https://ui.hindsight.vectorize.io). Without it the app runs a labelled offline fallback.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=adversewatch-clinic-demo
# Groq (https://console.groq.com/keys). Without it a labelled mock explainer is used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
